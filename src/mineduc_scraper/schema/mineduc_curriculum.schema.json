{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mineduc-curriculum-db/schema/mineduc_curriculum.schema.json",
  "title": "MineducCurriculumDB",
  "description": "Structured database of the Chilean national curriculum (MINEDUC / curriculumnacional.cl).",
  "type": "object",
  "required": [
    "metadata",
    "levels"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "scraped_at",
        "source_url",
        "total_oas",
        "schema_version"
      ],
      "properties": {
        "scraped_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "total_oas": {
          "type": "integer",
          "minimum": 0
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generator": {
          "type": "string"
        },
        "dataset_variant": {
          "type": "string",
          "enum": [
            "full",
            "slim"
          ]
        },
        "total_by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "total_levels": {
          "type": "integer",
          "minimum": 0
        },
        "total_oats": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "error"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "pages_without_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id_collisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_routes": {
          "type": "array",
          "description": "Subject pages folded away because the same subject is published under two curriculum bases.",
          "items": {
            "type": "object",
            "required": [
              "dropped",
              "kept"
            ],
            "properties": {
              "dropped": {
                "type": "string"
              },
              "kept": {
                "type": "string"
              }
            }
          }
        },
        "indicators": {
          "type": "object",
          "description": "Summary of the Programa de Estudio PDF indicator pass.",
          "properties": {
            "extracted_at": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "pdfs_read": {
              "type": "integer",
              "minimum": 0
            },
            "pdfs_failed": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "objectives_with_indicators": {
              "type": "integer",
              "minimum": 0
            },
            "total_indicators": {
              "type": "integer",
              "minimum": 0
            },
            "rows_renumbered": {
              "type": "integer",
              "minimum": 0
            },
            "rows_rejected_low_similarity": {
              "type": "integer",
              "minimum": 0
            },
            "rows_rejected_ambiguous": {
              "type": "integer",
              "minimum": 0
            },
            "match_threshold": {
              "type": "number"
            },
            "rows_joint": {
              "type": "integer",
              "minimum": 0
            },
            "rejected_rows": {
              "type": "array",
              "description": "Every indicator table row that was read from a Programa but could not be tied to a published objective, kept in full so the gap is auditable.",
              "items": {
                "type": "object",
                "required": [
                  "pdf_url",
                  "pdf_code",
                  "similarity",
                  "indicators"
                ],
                "properties": {
                  "where": {
                    "type": "string"
                  },
                  "level_id": {
                    "type": "string"
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "pdf_code": {
                    "type": "string"
                  },
                  "pdf_page": {
                    "type": "integer"
                  },
                  "pdf_url": {
                    "type": "string"
                  },
                  "similarity": {
                    "type": "number"
                  },
                  "closest_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "closest_oa_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pdf_statement": {
                    "type": "string"
                  },
                  "indicators": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "joint": {
                    "type": "boolean"
                  }
                }
              }
            },
            "ambiguous_rows": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Rows whose statement matched two objectives equally well and whose printed code did not disambiguate."
            }
          }
        },
        "tp_modules": {
          "type": "object"
        }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LevelData"
      }
    },
    "transversal_objectives": {
      "description": "OATs grouped by curriculum base slug. OATs are defined per curriculum base rather than per subject; resolve them through SubjectData.curriculum_base.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TransversalObjective"
        }
      }
    }
  },
  "$defs": {
    "LevelData": {
      "type": "object",
      "required": [
        "level_id",
        "level_name",
        "subjects"
      ],
      "properties": {
        "level_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "level_name": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SubjectData"
          }
        }
      }
    },
    "SubjectData": {
      "type": "object",
      "required": [
        "subject_id",
        "subject_name",
        "track",
        "learning_objectives"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "subject_name": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": "string",
          "enum": [
            "plan_comun",
            "plan_diferenciado_hc",
            "plan_diferenciado_tp"
          ]
        },
        "curriculum_base": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_base_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_ids": {
          "type": "object",
          "description": "MINEDUC's internal Drupal ids, useful for cross-referencing the site's own APIs.",
          "properties": {
            "base": {
              "type": [
                "string",
                "null"
              ]
            },
            "subject": {
              "type": [
                "string",
                "null"
              ]
            },
            "grade": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "doc_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Objective"
          }
        },
        "alias_urls": {
          "type": "array",
          "description": "Other URLs on the site that publish this same subject/level.",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Module"
          },
          "description": "Técnico-Profesional módulos, present only for track plan_diferenciado_tp."
        },
        "modules_source": {
          "type": "string",
          "format": "uri"
        },
        "modules_shared_programme": {
          "type": "boolean",
          "description": "True when this subject's Programa is shared with the speciality's menciones. It labels each módulo's year but not its mención, so the list may span menciones."
        }
      }
    },
    "Objective": {
      "type": "object",
      "required": [
        "oa_id",
        "oa_number",
        "category",
        "statement"
      ],
      "properties": {
        "oa_id": {
          "type": "string",
          "pattern": "^CL_[A-Z0-9_]+$"
        },
        "oa_number": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "conocimiento",
            "habilidad",
            "actitud"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Official MINEDUC code as printed in the Bases Curriculares, e.g. 'MA1M OA 07'."
        },
        "code_slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "strand_eje": {
          "type": "string",
          "minLength": 1
        },
        "strand_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "strand_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills_oah": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prioritized": {
          "type": "boolean",
          "description": "Flagged as part of the Priorizacion Curricular on curriculumnacional.cl."
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "indicators_source": {
          "type": "array",
          "description": "URLs of the Programa de Estudio PDFs the indicators were read from.",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "indicators_scope": {
          "type": "string",
          "enum": [
            "objective",
            "unit",
            "mixed"
          ],
          "description": "Whether the indicators are published per objective, or for a group of objectives jointly (the 2021 3° y 4° Medio 'Actividad de Evaluación' tables), or both."
        }
      }
    },
    "TransversalObjective": {
      "type": "object",
      "required": [
        "oat_id",
        "dimension",
        "statement"
      ],
      "properties": {
        "oat_id": {
          "type": "string",
          "pattern": "^CL_OAT_[A-Z0-9_]+$"
        },
        "oat_number": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string"
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "dimension_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_base": {
          "type": "string"
        }
      }
    },
    "ExpectedLearning": {
      "type": "object",
      "required": [
        "number",
        "statement"
      ],
      "description": "An Aprendizaje Esperado of a Técnico-Profesional módulo, with its Criterios de Evaluación.",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Criterios de Evaluación, each prefixed with its printed number."
        },
        "generic_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Objetivos de Aprendizaje Genéricos (OAG) letters this AE develops."
        }
      }
    },
    "Module": {
      "type": "object",
      "required": [
        "module_number",
        "module_name",
        "expected_learnings"
      ],
      "description": "A módulo of a Técnico-Profesional speciality.",
      "properties": {
        "module_number": {
          "type": "integer",
          "minimum": 1
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "grade": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Speciality objective codes as printed in the Programa."
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "oa_ids of this dataset's objectives the módulo addresses, resolved by statement."
        },
        "expected_learnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedLearning"
          }
        }
      }
    }
  }
}
