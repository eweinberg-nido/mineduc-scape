{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mineduc-curriculum-db/schema/mineduc_curriculum.schema.json",
  "title": "MineducCurriculumDB",
  "description": "Structured database of the Chilean national curriculum (MINEDUC / curriculumnacional.cl). Every objective carries provenance identifying the exact source it was extracted from, and a curriculum status that is only ever asserted when an official source backs it.",
  "type": "object",
  "required": [
    "metadata",
    "levels"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "scraped_at",
        "source_url",
        "total_oas",
        "schema_version"
      ],
      "properties": {
        "scraped_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "total_oas": {
          "type": "integer",
          "minimum": 0
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "generator": {
          "type": "string"
        },
        "dataset_variant": {
          "type": "string",
          "enum": [
            "full",
            "slim"
          ]
        },
        "total_by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_subjects": {
          "type": "integer",
          "minimum": 0
        },
        "total_levels": {
          "type": "integer",
          "minimum": 0
        },
        "total_oats": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "error"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        },
        "pages_without_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id_collisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_routes": {
          "type": "array",
          "description": "Subject pages folded away because the same subject is published under two curriculum bases.",
          "items": {
            "type": "object",
            "required": [
              "dropped",
              "kept"
            ],
            "properties": {
              "dropped": {
                "type": "string"
              },
              "kept": {
                "type": "string"
              }
            }
          }
        },
        "indicators": {
          "type": "object",
          "description": "Summary of the Programa de Estudio PDF indicator pass.",
          "properties": {
            "extracted_at": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "pdfs_read": {
              "type": "integer",
              "minimum": 0
            },
            "pdfs_failed": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "objectives_with_indicators": {
              "type": "integer",
              "minimum": 0
            },
            "total_indicators": {
              "type": "integer",
              "minimum": 0
            },
            "rows_renumbered": {
              "type": "integer",
              "minimum": 0
            },
            "rows_rejected_low_similarity": {
              "type": "integer",
              "minimum": 0
            },
            "rows_rejected_ambiguous": {
              "type": "integer",
              "minimum": 0
            },
            "match_threshold": {
              "type": "number"
            },
            "rows_joint": {
              "type": "integer",
              "minimum": 0
            },
            "rejected_rows": {
              "type": "array",
              "description": "Every indicator table row that was read from a Programa but could not be tied to a published objective, kept in full so the gap is auditable.",
              "items": {
                "type": "object",
                "required": [
                  "pdf_url",
                  "pdf_code",
                  "similarity",
                  "indicators"
                ],
                "properties": {
                  "where": {
                    "type": "string"
                  },
                  "level_id": {
                    "type": "string"
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "pdf_code": {
                    "type": "string"
                  },
                  "pdf_page": {
                    "type": "integer"
                  },
                  "pdf_url": {
                    "type": "string"
                  },
                  "similarity": {
                    "type": "number"
                  },
                  "closest_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "closest_oa_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pdf_statement": {
                    "type": "string"
                  },
                  "indicators": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "joint": {
                    "type": "boolean"
                  }
                }
              }
            },
            "ambiguous_rows": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Rows whose statement matched two objectives equally well and whose printed code did not disambiguate."
            }
          }
        },
        "tp_modules": {
          "type": "object"
        },
        "epja_bases": {
          "type": "object",
          "description": "Summary of the Bases Curriculares EPJA PDF ingestion pass."
        },
        "religion": {
          "type": "object",
          "description": "The Religión finding: why those pages publish no objectives, and the evidence."
        },
        "corrections": {
          "type": "object",
          "properties": {
            "applied": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "skipped": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "object"
        },
        "prioritization": {
          "$ref": "#/$defs/Prioritization"
        },
        "coverage": {
          "type": "object",
          "description": "Summary of the coverage report, computed against the official source inventory rather than against a previous run's total."
        },
        "integrity": {
          "type": "object",
          "description": "Text-integrity findings: statements that look truncated, mojibake, joined words, duplicate or conflicting text."
        },
        "status_summary": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_by_source_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_epja_objectives": {
          "type": "integer",
          "minimum": 0
        },
        "total_religion_objectives": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_official_codes": {
          "type": "integer",
          "minimum": 0
        },
        "total_offerings": {
          "type": "integer",
          "minimum": 0
        },
        "oat_verification": {
          "type": "object",
          "description": "Result of re-reading the transversal objectives from MINEDUC's JSON:API and comparing codes, dimensions and statements field by field, plus the reason each curriculum base without OATs has none."
        },
        "built_at": {
          "type": "string",
          "format": "date-time",
          "description": "When these artefacts were generated. Distinct from scraped_at, which is when the HTML crawl ran; a build that augments an existing crawl advances built_at only, and that is what clients version their cached copy on."
        }
      }
    },
    "levels": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/LevelData"
      }
    },
    "transversal_objectives": {
      "description": "OATs grouped by curriculum base slug. OATs are defined per curriculum base rather than per subject; resolve them through SubjectData.curriculum_base.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/TransversalObjective"
        }
      }
    }
  },
  "$defs": {
    "LevelData": {
      "type": "object",
      "required": [
        "level_id",
        "level_name",
        "subjects"
      ],
      "properties": {
        "level_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "level_name": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/SubjectData"
          }
        },
        "level_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a combined level, the site level_ids it spans."
        },
        "level_note": {
          "type": "string"
        }
      }
    },
    "SubjectData": {
      "type": "object",
      "required": [
        "subject_id",
        "subject_name",
        "track",
        "learning_objectives"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "subject_name": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": "string",
          "enum": [
            "plan_comun",
            "plan_diferenciado_hc",
            "plan_diferenciado_tp"
          ]
        },
        "curriculum_base": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_base_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "source_ids": {
          "type": "object",
          "description": "MINEDUC's internal Drupal ids, useful for cross-referencing the site's own APIs.",
          "properties": {
            "base": {
              "type": [
                "string",
                "null"
              ]
            },
            "subject": {
              "type": [
                "string",
                "null"
              ]
            },
            "grade": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "doc_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "learning_objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Objective"
          }
        },
        "alias_urls": {
          "type": "array",
          "description": "Other URLs on the site that publish this same subject/level.",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Module"
          },
          "description": "Técnico-Profesional módulos, present only for track plan_diferenciado_tp."
        },
        "modules_source": {
          "type": "string",
          "format": "uri"
        },
        "modules_shared_programme": {
          "type": "boolean",
          "description": "True when this subject's Programa is shared with the speciality's menciones. It labels each módulo's year but not its mención, so the list may span menciones."
        },
        "curriculum_status": {
          "type": "string",
          "enum": [
            "vigente",
            "propuesta",
            "en_implementacion",
            "historico",
            "desconocido"
          ],
          "description": "Legal/implementation status of the curriculum this record belongs to. Never inferred from a page being reachable; anything other than 'desconocido' must carry a status_source."
        },
        "status_source": {
          "$ref": "#/$defs/StatusSource"
        },
        "no_objectives_reason": {
          "$ref": "#/$defs/NoObjectivesReason"
        },
        "objectives_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "html_curriculum_page",
            "jsonapi",
            "base_curricular_pdf",
            "programa_estudio_pdf",
            null
          ]
        },
        "objectives_in_level": {
          "type": "string",
          "description": "level_id where this subject's objectives are published, when the Bases define them for a combined level."
        },
        "formation_area": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "formacion_general",
            "formacion_instrumental",
            "formacion_diferenciada_hc",
            "formacion_diferenciada_tp",
            null
          ],
          "description": "EPJA ámbito de formación. Carried on the subject because an EPJA asignatura belongs to exactly one, and it is not the same axis as `track`."
        },
        "formation_area_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "site_page_published": {
          "type": "boolean",
          "description": "False when the Bases define this offering but the site navigates no page for it."
        },
        "objectives_source_note": {
          "type": "string"
        },
        "programme_model": {
          "type": "object",
          "description": "For subjects whose curriculum is not a single national one (Religión), how programmes are approved and by whom."
        },
        "big_ideas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "essential_knowledge": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Conocimientos esenciales, published per asignatura and nivel in the EPJA Bases."
        }
      }
    },
    "Objective": {
      "type": "object",
      "required": [
        "oa_id",
        "oa_number",
        "category",
        "statement"
      ],
      "properties": {
        "oa_id": {
          "type": "string",
          "pattern": "^CL_[A-Z0-9_]+$"
        },
        "oa_number": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "conocimiento",
            "habilidad",
            "actitud"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Official MINEDUC code as printed in the Bases Curriculares, e.g. 'MA1M OA 07'."
        },
        "code_slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "strand_eje": {
          "type": "string",
          "minLength": 1
        },
        "strand_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "strand_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skills_oah": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prioritized": {
          "type": "boolean",
          "description": "Kept for backward compatibility. It records membership of the Priorización Curricular 2023-2025 and nothing about the present; read `prioritization` instead, and never render it as a bare 'Priorizado'."
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "indicators_source": {
          "type": "array",
          "description": "URLs of the Programa de Estudio PDFs the indicators were read from.",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "indicators_scope": {
          "type": "string",
          "enum": [
            "objective",
            "unit",
            "mixed"
          ],
          "description": "Whether the indicators are published per objective, or for a group of objectives jointly (the 2021 3° y 4° Medio 'Actividad de Evaluación' tables), or both."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "curriculum_status": {
          "type": "string",
          "enum": [
            "vigente",
            "propuesta",
            "en_implementacion",
            "historico",
            "desconocido"
          ],
          "description": "Legal/implementation status of the curriculum this record belongs to. Never inferred from a page being reachable; anything other than 'desconocido' must carry a status_source."
        },
        "status_source": {
          "$ref": "#/$defs/StatusSource"
        },
        "prioritization": {
          "$ref": "#/$defs/Prioritization"
        },
        "correction": {
          "$ref": "#/$defs/Correction"
        },
        "level_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Site level_ids this objective applies to, when the Bases define it for a combined level."
        }
      }
    },
    "TransversalObjective": {
      "type": "object",
      "required": [
        "oat_id",
        "dimension",
        "statement"
      ],
      "properties": {
        "oat_id": {
          "type": "string",
          "pattern": "^CL_OAT_[A-Z0-9_]+$"
        },
        "oat_number": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string"
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "dimension_description": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "curriculum_base": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "curriculum_status": {
          "type": "string",
          "enum": [
            "vigente",
            "propuesta",
            "en_implementacion",
            "historico",
            "desconocido"
          ],
          "description": "Legal/implementation status of the curriculum this record belongs to. Never inferred from a page being reachable; anything other than 'desconocido' must carry a status_source."
        },
        "status_source": {
          "$ref": "#/$defs/StatusSource"
        }
      }
    },
    "ExpectedLearning": {
      "type": "object",
      "required": [
        "number",
        "statement"
      ],
      "description": "An Aprendizaje Esperado of a Técnico-Profesional módulo, with its Criterios de Evaluación.",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Criterios de Evaluación, each prefixed with its printed number."
        },
        "generic_objectives": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Objetivos de Aprendizaje Genéricos (OAG) letters this AE develops."
        }
      }
    },
    "Module": {
      "type": "object",
      "required": [
        "module_number",
        "module_name",
        "expected_learnings"
      ],
      "description": "A módulo of a Técnico-Profesional speciality.",
      "properties": {
        "module_number": {
          "type": "integer",
          "minimum": 1
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "hours": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "grade": {
          "type": [
            "string",
            "null"
          ]
        },
        "objective_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Speciality objective codes as printed in the Programa."
        },
        "objective_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "oa_ids of this dataset's objectives the módulo addresses, resolved by statement."
        },
        "expected_learnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedLearning"
          }
        }
      }
    },
    "Provenance": {
      "type": "object",
      "description": "Where a record's text came from, precisely enough to re-fetch and re-verify it.",
      "required": [
        "source_url",
        "source_type",
        "retrieved_at",
        "extraction_method"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "description": "The exact URL the text was read from."
        },
        "source_type": {
          "type": "string",
          "enum": [
            "html_curriculum_page",
            "jsonapi",
            "base_curricular_pdf",
            "programa_estudio_pdf"
          ]
        },
        "source_document": {
          "type": "string",
          "description": "Title of the source document, when it is a PDF."
        },
        "source_page": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based page of the source PDF, as a reader would cite it."
        },
        "curriculum_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string"
        },
        "extraction_method": {
          "type": "string",
          "description": "Which engine produced this record, and how."
        }
      }
    },
    "StatusSource": {
      "type": [
        "object",
        "null"
      ],
      "description": "The official source backing a curriculum_status. Required for every status other than 'desconocido'.",
      "required": [
        "url",
        "note",
        "verified_on"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "verified_on": {
          "type": "string"
        }
      }
    },
    "Prioritization": {
      "type": "object",
      "description": "Historical membership of a prioritized curriculum subset. Not a present-tense property: `prioritized: true` recorded the Priorización Curricular published for 2023-2025.",
      "required": [
        "programme",
        "period",
        "status"
      ],
      "properties": {
        "programme": {
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "historico",
            "vigente",
            "propuesta",
            "en_implementacion",
            "desconocido"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "Correction": {
      "type": "object",
      "description": "A reviewed correction applied where official sources contradict each other. The extracted value is kept so the change is never silent.",
      "required": [
        "id",
        "field",
        "original_value",
        "corrected_value",
        "authoritative_source_url",
        "explanation",
        "verified_on"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
